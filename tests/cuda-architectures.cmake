include("${CMAKE_CURRENT_LIST_DIR}/../cmake/CuvisCudaArchitectures.cmake")

function(assert_architectures toolkit_version expected)
  cuvis_default_cuda_architectures("${toolkit_version}" actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR
      "CUDA ${toolkit_version}: expected '${expected}', got '${actual}'")
  endif()
endfunction()

assert_architectures("11.0" "60;70;75;80")
assert_architectures("11.1" "60;70;75;80;86")
assert_architectures("11.4" "60;70;75;80;86;87")
assert_architectures("11.8" "60;70;75;80;86;87;89;90")
assert_architectures("12.0" "60;70;75;80;86;87;89;90")
assert_architectures("12.8" "60;70;75;80;86;87;89;90;100;101;120")
assert_architectures("12.9" "60;70;75;80;86;87;89;90;100;101;103;120;121")
assert_architectures("13.0" "75;80;86;87;89;90;100;103;110;120;121")
assert_architectures("13.4" "75;80;86;87;88;89;90;100;103;107;110;120;121")

cuvis_default_cuda_architectures("10.2" unsupported)
if(NOT "${unsupported}" STREQUAL "")
  message(FATAL_ERROR "CUDA 10.2 must not receive a default architecture list")
endif()
cuvis_default_cuda_architectures("11.9" unverified_11_minor)
if(NOT "${unverified_11_minor}" STREQUAL "")
  message(FATAL_ERROR "Unverified CUDA 11.x toolkits must require explicit architectures")
endif()
cuvis_default_cuda_architectures("12.10" unverified_12_minor)
if(NOT "${unverified_12_minor}" STREQUAL "")
  message(FATAL_ERROR "Unverified CUDA 12.x toolkits must require explicit architectures")
endif()
cuvis_default_cuda_architectures("13.5" unverified_future)
if(NOT "${unverified_future}" STREQUAL "")
  message(FATAL_ERROR "Unverified future toolkits must require explicit architectures")
endif()

cuvis_select_cuda_architectures("NVIDIA" "13.0" TRUE "86;89;120" "75" selected)
if(NOT "${selected}" STREQUAL "86;89;120")
  message(FATAL_ERROR "Explicit CMAKE_CUDA_ARCHITECTURES was not preserved: '${selected}'")
endif()
cuvis_select_cuda_architectures("NVIDIA" "13.0" TRUE "" "75" selected_empty)
if(NOT "${selected_empty}" STREQUAL "")
  message(FATAL_ERROR "An explicitly empty CMAKE_CUDA_ARCHITECTURES must be preserved")
endif()
cuvis_select_cuda_architectures("NVIDIA" "13.0" FALSE "" "87;90" selected_env)
if(NOT "${selected_env}" STREQUAL "87;90")
  message(FATAL_ERROR "CUDAARCHS environment setting was not preserved: '${selected_env}'")
endif()
cuvis_select_cuda_architectures("NVIDIA" "11.0" FALSE "" "" selected_default)
if(NOT "${selected_default}" STREQUAL "60;70;75;80")
  message(FATAL_ERROR "Default toolkit architecture selection failed: '${selected_default}'")
endif()
cuvis_select_cuda_architectures("Clang" "13.0" FALSE "" "" clang_default)
if(NOT "${clang_default}" STREQUAL "")
  message(FATAL_ERROR "Unverified non-NVIDIA compilers must require explicit architectures")
endif()

message(STATUS "CUDA architecture selection tests passed")
